// TEMP DEBUG: test parents fetch
app.get("/api/debug/parents/:fileId", async (req, res) => {
  const axios = (await import("axios")).default;
  const apiKey = process.env.GOOGLE_DRIVE_API_KEY || "";
  try {
    const r = await axios.get(`https://www.googleapis.com/drive/v3/files/${req.params.fileId}`, {
      params: { key: apiKey, fields: "id,name,parents" }
    });
    res.json(r.data);
  } catch (e: any) {
    res.status(500).json({ error: e.message, response: e.response?.data });
  }
});
